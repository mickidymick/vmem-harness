# vmem/ is its own repository (gitlab.com:corsys/vmem) — never nest it here.
/vmem/

# Every run writes a fresh timestamped directory; results are reproduced, not tracked.
/results/

# Benchmark source code is NEVER kept here -- it lives in its original trees
# (~/Projects/benchmarks, ~/projects/memory-ef/benchmarks, the SPEC install), and each
# bench's build.sh / stage.sh points at it. Run dirs hold binaries, symlinked data and
# outputs; only the measured footprint.txt is tracked.
benchmarks/*/src/
benchmarks/*/.attic/
benchmarks/*/run/*
!benchmarks/*/run/footprint.txt

# Library/binary snapshots taken before a rebuild.
*.bak-*

# Logs and stats dumps.
*.log
*.stats
*.stats.*
vpage_llc_misses.out

__pycache__/
*.pyc

